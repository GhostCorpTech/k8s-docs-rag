# OpenAI-compatible cloud API
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4.1-mini

# Embeddings: local is the default and requires no API key.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-base
MODEL_CACHE_PATH=data/models
LOCAL_EMBEDDING_BATCH_SIZE=4
LOCAL_EMBEDDING_THREADS=6

# Optional OpenAI-compatible provider (when EMBEDDING_PROVIDER=openai).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
RERANK_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-mini

# Infrastructure
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
SQLITE_PATH=data/rag.db
DOCKER_SQLITE_PATH=/app/data/rag.db
COLLECTION_PREFIX=kubernetes_docs
DOCS_REPO_PATH=data/kubernetes-website
EVAL_PATH=eval/questions.jsonl

# Retrieval and generation
DENSE_LIMIT=30
LEXICAL_LIMIT=30
FINAL_LIMIT=8
RRF_K=60
RRF_DENSE_WEIGHT=1.0
RRF_LEXICAL_WEIGHT=1.0
MAX_CONTEXT_CHARS=30000

# Browser client
VITE_API_URL=http://localhost:8088
