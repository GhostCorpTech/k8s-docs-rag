# --- LLM provider (any OpenAI-compatible endpoint) ------------------------------------
# Used for query translation, follow-up rewriting, answers, optional reranking and the judge.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4.1-mini
RERANK_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-mini

# --- Embeddings ----------------------------------------------------------------------
# local = intfloat/multilingual-e5-base via ONNX (no API key, ~1.1 GB download on first run)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-base
LOCAL_EMBEDDING_BATCH_SIZE=4
LOCAL_EMBEDDING_THREADS=6
# Only for EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# --- Storage (paths are relative to the repository root when running locally) --------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_PREFIX=kubernetes_docs
SQLITE_PATH=data/rag.db
DOCS_REPO_PATH=data/kubernetes-website
MODEL_CACHE_PATH=data/models
EVAL_PATH=eval/questions.jsonl
API_PRICING_PATH=data/billing/pricing.json

# --- Retrieval (values used in the published benchmark) -----------------------------
DENSE_LIMIT=30
LEXICAL_LIMIT=30
FINAL_LIMIT=8
RRF_K=60
RRF_DENSE_WEIGHT=1.0
RRF_LEXICAL_WEIGHT=1.0
MAX_CONTEXT_CHARS=30000

# --- Public demo (docker-compose.demo.yml sets DEMO_MODE=true; see docs/DEPLOY.md) ----
# Port on 127.0.0.1 that your reverse proxy forwards to.
DEMO_PORT=8090
# Public URL of the demo: create-key then prints a ready-to-send link with the key.
DEMO_PUBLIC_URL=https://k8s-docs.ghostcorp.online
# Shown on the demo landing page.
DEMO_REPOSITORY_URL=
DEMO_CONTACT_EMAIL=tech@ghostcorp.online
DEMO_CONTACT_TELEGRAM=https://t.me/GhostCorpTech
# Defaults for new keys, and a hard cap on questions per UTC day for the whole server.
DEMO_KEY_DAYS=30
DEMO_KEY_DAILY_LIMIT=20
DEMO_GLOBAL_DAILY_LIMIT=200
